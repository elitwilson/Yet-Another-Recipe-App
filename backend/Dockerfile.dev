FROM rust:1.88-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN cargo install cargo-watch
RUN cargo install sqlx-cli --no-default-features --features native-tls,postgres

EXPOSE 3000

# Run migrations once on container start, then hand off to cargo-watch.
# --poll because Docker on macOS doesn't forward inotify events.
CMD ["sh", "-c", "sqlx migrate run --source /app/migrations && cargo watch --poll -x 'run --bin yara-backend'"]
