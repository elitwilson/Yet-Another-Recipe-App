# Database connection URL for the backend.
# When running the backend outside Docker (e.g. cargo run), point at the
# compose Postgres on localhost. STR-006 will introduce the in-network host form.
DATABASE_URL=postgres://yara:yara@localhost:5432/yara

# Server bind address and port (optional — defaults shown)
# YARA_HOST=127.0.0.1
# YARA_PORT=3000
