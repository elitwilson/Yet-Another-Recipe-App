# Postgres credentials — used by docker-compose.yml
POSTGRES_USER=yara
POSTGRES_PASSWORD=yara
POSTGRES_DB=yara
# Port exposed on the host. Change to 5433 if 5432 is occupied by another Postgres container.
POSTGRES_PORT=5432

# Backend — host port for direct API access (internal port is always 3000)
YARA_PORT=3001

# Frontend — host port for the Vite dev server
FRONTEND_PORT=3000
