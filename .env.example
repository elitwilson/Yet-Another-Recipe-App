# Postgres credentials — used by docker-compose.yml
POSTGRES_USER=yara
POSTGRES_PASSWORD=yara
POSTGRES_DB=yara
# Port exposed on the host. Change to 5433 if 5432 is occupied by another Postgres container.
POSTGRES_PORT=5432

# Backend — host port for the Compose backend service (internal port is always 3000)
YARA_PORT=3000

# Frontend — host port that maps to nginx:80 inside the frontend container
FRONTEND_PORT=5173
