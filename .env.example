# Postgres credentials — used by docker-compose.yml and ./dev.sh
POSTGRES_USER=yara
POSTGRES_PASSWORD=yara
POSTGRES_DB=yara
# Host port the compose Postgres is published on. The native backend connects here.
POSTGRES_PORT=5433

# Native dev ports (./dev.sh runs backend + frontend on the host)
# Backend listen port — the Vite dev server proxies /api here.
YARA_PORT=3000
# Vite dev server port.
FRONTEND_PORT=5173
